{
  "name": "word-editing-assistant",
  "version": "0.1.0",
  "description": "Word add-in for grammar/style suggestions and citation formatting using the Claude API",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dev:taskpane": "webpack serve --mode development",
    "dev:server": "ts-node-dev --respawn --project server/tsconfig.json server/index.ts",
    "validate": "office-addin-manifest validate manifest.xml"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/office-js": "^1.0.420",
    "copy-webpack-plugin": "^12.0.2",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-dev-certs": "^1.13.0",
    "office-addin-manifest": "^1.13.0",
    "ts-loader": "^9.5.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
